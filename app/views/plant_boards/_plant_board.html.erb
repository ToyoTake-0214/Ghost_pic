<div class="p-4 md:w-1/3">
  <div class="flex h-full flex-col overflow-hidden rounded-lg border-2 border-gray-200 border-opacity-60 bg-white">
    <%= image_tag plant_board.plant_board_image_url,
                  class: "h-72 w-full object-cover object-center" %>

    <div class="flex flex-1 flex-col p-6">
      <div class="mb-1 flex items-center justify-between">
        <h2 class="text-xs font-medium tracking-widest text-gray-400">
          MY PLANT
        </h2>

        <div class="flex items-center gap-3 text-gray-400">
          <%= link_to edit_plant_board_path(plant_board),
                      class: "hover:text-gray-600",
                      title: "編集",
                      aria: { label: "編集" } do %>
            <svg xmlns="http://www.w3.org/2000/svg"
                 fill="none"
                 viewBox="0 0 24 24"
                 stroke-width="1.5"
                 stroke="currentColor"
                 class="h-5 w-5">
              <path stroke-linecap="round"
                    stroke-linejoin="round"
                    d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
            </svg>
          <% end %>

          <%= link_to plant_board_path(plant_board),
                      class: "hover:text-red-500",
                      title: "削除",
                      aria: { label: "削除" },
                      data: {
                        turbo_method: :delete,
                        turbo_confirm: "削除しますか？"
                      } do %>
            <svg xmlns="http://www.w3.org/2000/svg"
                 fill="none"
                 viewBox="0 0 24 24"
                 stroke-width="1.5"
                 stroke="currentColor"
                 class="h-5 w-5">
              <path stroke-linecap="round"
                    stroke-linejoin="round"
                    d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673A2.25 2.25 0 0 1 15.916 21H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
            </svg>
          <% end %>
        </div>
      </div>

      <h1 class="mb-3">
        <%= link_to plant_board.plant_name,
                    plant_board_path(plant_board),
                    class: "text-lg font-medium text-gray-900 hover:text-green-700" %>
      </h1>

      <p class="mb-10 line-clamp-3 text-gray-600">
        <%= plant_board.body %>
      </p>

      <% remaining_days = plant_board.watering_remaining_days %>

      <% unless remaining_days.nil? %>
        <% if remaining_days.positive? %>
          <% watering_status_text = "水やりはまだ必要ありません" %>
          <% watering_status_detail = "次の水やりまであと#{remaining_days}日です" %>
          <% watering_status_class = "border-green-200 bg-green-50 text-green-700" %>
        <% elsif remaining_days.zero? %>
          <% watering_status_text = "今日が水やり日です" %>
          <% watering_status_detail = "今日の水やりを記録できます" %>
          <% watering_status_class = "border-sky-200 bg-sky-50 text-sky-700" %>
        <% else %>
          <% watering_status_text = "水やりが必要です" %>
          <% watering_status_detail = "水やり予定日を#{remaining_days.abs}日過ぎています" %>
          <% watering_status_class = "border-red-200 bg-red-50 text-red-700" %>
        <% end %>

        <div class="mb-6 text-sm">
          <div class="rounded-lg border px-4 py-3 <%= watering_status_class %>">
            <p class="font-medium">
              <%= watering_status_text %>
            </p>

            <p class="mt-1 text-xs opacity-80">
              <%= watering_status_detail %>
            </p>

            <p class="mt-1 text-xs opacity-80">
              水やり頻度：<%= plant_board.watering_interval_days %>日ごと
            </p>
          </div>
        </div>
      <% end %>

      <div class="mt-auto space-y-3">
        <%= link_to "育成記録を見る",
                    plant_board_path(plant_board),
                    class: "inline-flex w-full items-center justify-center rounded-lg border border-green-300 bg-white px-0 py-3 text-sm font-medium text-green-700 hover:bg-green-50 focus:bg-green-50 focus:outline-hidden" %>

        <% if remaining_days.nil? %>
          <%= link_to "水やり頻度を設定する",
                      edit_plant_board_path(plant_board),
                      class: "inline-flex w-full items-center justify-center gap-x-2 rounded-lg border border-gray-300 bg-gray-50 px-0 py-3 text-sm font-medium text-gray-700 hover:bg-gray-100 focus:bg-gray-100 focus:outline-hidden" %>
        <% else %>
          <%= link_to "今日の水やりを記録",
                      water_plant_board_path(plant_board),
                      class: "inline-flex w-full items-center justify-center gap-x-2 rounded-lg border border-sky-300 bg-sky-50 px-0 py-3 text-sm font-medium text-sky-700 hover:bg-sky-100 focus:bg-sky-100 focus:outline-hidden disabled:pointer-events-none disabled:opacity-50",
                      data: { turbo_method: :patch } %>
        <% end %>
      </div>
    </div>
  </div>
</div>
